{
  "profile_id": "default",
  "profile_name": "Default WordPress",
  "profile_version": "1.0.0",
  "juggernaut_version": ">=1.0.0",
  "sites": [
    {
      "id": "production",
      "name": "My WordPress Site",
      "url": "https://example.com",
      "description": "Placeholder site. Import your own profile in Settings > Profiles.",
      "is_default": true,
      "environment": "production"
    }
  ],
  "required_plugins": [
    {
      "id": "ai-fill",
      "version": ">=1.0.0",
      "source": "bundled",
      "auto_enable": true
    },
    {
      "id": "custom-views",
      "version": ">=1.0.0",
      "source": "bundled",
      "auto_enable": true
    }
  ],
  "post_types": [
    {
      "slug": "post",
      "name": "Posts",
      "rest_base": "posts",
      "icon": "Newspaper",
      "supports": ["title", "editor", "thumbnail", "excerpt"],
      "is_primary": true
    },
    {
      "slug": "page",
      "name": "Pages",
      "rest_base": "pages",
      "icon": "FileText",
      "supports": ["title", "editor", "thumbnail"],
      "is_primary": false
    }
  ],
  "taxonomies": [
    {
      "slug": "category",
      "name": "Categories",
      "rest_base": "categories",
      "post_types": ["post"],
      "hierarchical": true,
      "show_in_filter": true,
      "filter_position": 1,
      "show_in_table": true,
      "table_position": 1,
      "table_max_display": 3,
      "editable": true
    },
    {
      "slug": "post_tag",
      "name": "Tags",
      "rest_base": "tags",
      "post_types": ["post"],
      "hierarchical": false,
      "show_in_filter": true,
      "filter_position": 2,
      "show_in_table": true,
      "table_position": 2,
      "table_max_display": 3,
      "editable": true
    }
  ],
  "plugin_settings": {
    "content-planner": {
      "classification": {
        "primary": { "taxonomy": "category", "label": "Category" },
        "tags": { "taxonomy": "post_tag", "label": "Tags" }
      }
    }
  },
  "ui": {
    "branding": {
      "app_name": "Juggernaut",
      "primary_color": "#6366f1"
    },
    "features": {
      "ai_fill": true,
      "prompt_templates": true,
      "bulk_edit": true,
      "diagnostics": true
    }
  }
}
